# surveil - configuration
# Copy to `.env` in the repo root and edit as needed.
# Every variable is optional; the defaults in backend/app/config.py are the
# values documented in refernces/surveil.docx.

# ---------------------------------------------------------------- camera
SURVEIL_CAMERA_SOURCE=0
SURVEIL_FRAME_WIDTH=640
SURVEIL_FRAME_HEIGHT=480
SURVEIL_CAPTURE_FPS_TARGET=30
SURVEIL_STREAM_JPEG_QUALITY=70

# ---------------------------------------------------- product detection (YOLO)
# Any ultralytics checkpoint. The COCO default detects the common shop items
# (bottle, cup, book, cell phone, laptop, ...). Point this at your own fine-tuned
# checkpoint for a specific shop.
SURVEIL_YOLO_MODEL=yolo11n.pt
SURVEIL_YOLO_CONF=0.35
SURVEIL_YOLO_IOU=0.5
SURVEIL_YOLO_IMGSZ=640
# SURVEIL_YOLO_DEVICE=0
# SURVEIL_YOLO_HALF=true

# HARD REQUIREMENT: these classes are never boxed, highlighted, tracked or
# written to the ledger. They are only counted for the operator.
SURVEIL_IGNORED_CLASSES=person,people,human,hand,face

# The basket is a YOLO class when your model has one; otherwise drag the region
# on the live feed in Tab 1. Stock COCO has no basket class.
SURVEIL_BASKET_CLASS_NAMES=basket,shopping_basket,shopping basket,tote,tote bag
# Normalised [x, y, w, h] fallback, used only when no basket class is detected.
SURVEIL_BASKET_ROI=0.66,0.58,0.32,0.40

# ------------------------------------------------------------------ tracking
SURVEIL_TRACKER_HIGH_THRESHOLD=0.5
SURVEIL_TRACKER_LOW_THRESHOLD=0.1
SURVEIL_TRACKER_MATCH_THRESHOLD=0.3
SURVEIL_TRACKER_SECOND_MATCH_THRESHOLD=0.15

# How long a product identity is held after its track dies, so a later detection
# can be re-associated onto the same product_id (see README -> Identity).
SURVEIL_IDENTITY_HOLD_SECONDS=45

# ------------------------------------------------------ hand detection (ONNX)
# auto | onnx | pose | mediapipe | off
#   onnx  - the imported victordibia/handtracking model (egocentric, trained on EgoHands)
#   pose  - YOLO pose wrist keypoints as a hand-box proxy (works on third-person views)
SURVEIL_HAND_BACKEND=auto
SURVEIL_HAND_ENABLED=true
SURVEIL_HAND_CONF_THRESHOLD=0.27
SURVEIL_HAND_NMS_IOU=0.4
SURVEIL_HAND_MAX_DETECTIONS=10

# pose backend only
SURVEIL_POSE_MODEL=yolo11n-pose.pt
SURVEIL_POSE_WRIST_CONF=0.4
SURVEIL_POSE_HAND_BOX_SIZE=90

# ------------------------------------------------------------------- ledger
# SURVEIL_DB_PATH=data/surveil.db
SURVEIL_AUTO_START_PIPELINE=true
SURVEIL_UNACCOUNTED_ALERT_SECONDS=90

# ------------------------------------------------- state machine thresholds
# Prefix SURVEIL_T_ (ThresholdSettings)
SURVEIL_T_SHELF_DISPLACEMENT_PX=60
SURVEIL_T_SETTLE_FRAMES=15
SURVEIL_T_SETTLE_MOTION_PX=6
SURVEIL_T_HAND_TOUCH_PX=20
SURVEIL_T_HAND_TOUCH_MIN_OVERLAP=0.05
SURVEIL_T_LIFT_CONFIRM_FRAMES=5
SURVEIL_T_RETURN_CONFIRM_FRAMES=5
SURVEIL_T_BASKET_OVERLAP_RATIO=0.5
SURVEIL_T_BASKET_CONFIRM_FRAMES=4
# A product that was IN_HAND and overlapping the basket is recorded as
# PLACED_IN_BASKET (flagged `inferred`) when occluded, instead of being
# reported as a lost track.
SURVEIL_T_INFER_BASKET_ON_OCCLUSION=true
SURVEIL_T_TOUCH_EMIT_FRAMES=2
SURVEIL_T_MAX_MISSED_FRAMES=30
SURVEIL_T_MARK_LOST_STATE=true
SURVEIL_T_LOST_EMIT_EVENT=true
